  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["lcd1:GND", "esp:GND.2", "black", ["v0", "h-20"]],
    ["lcd1:VCC", "esp:3V3", "red", ["v0", "h-10"]],
    ["lcd1:SDA", "esp:21", "green", ["v20", "h-40"]],
    ["lcd1:SCL", "esp:22", "blue", ["v30", "h-30"]],

    ["keypad1:R1", "esp:19", "green", ["v0"]],
    ["keypad1:R2", "esp:18", "green", ["v0"]],
    ["keypad1:R3", "esp:5", "green", ["v0"]],
    ["keypad1:R4", "esp:17", "green", ["v0"]],
    ["keypad1:C1", "esp:16", "yellow", ["v0"]],
    ["keypad1:C2", "esp:4", "yellow", ["v0"]],
