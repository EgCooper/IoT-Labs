    ["led_g:C", "esp:GND.3", "black", ["v20", "h0"]],
    ["led_r:C", "esp:GND.3", "black", ["v20", "h0"]],
    ["r1:2", "led_g:A", "green", ["h0"]],
    ["r2:2", "led_r:A", "red", ["h0"]],
    ["esp:25", "r1:1", "green", ["h-40", "v0"]],
