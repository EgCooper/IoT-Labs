{
  "version": 1,
  "author": "Lab IoT - ESP32 + DHT22",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": 80, "left": 300, "attrs": { "temperature": "38.1", "humidity": "65" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "dht1:VCC", "esp:3V3",   "red",   ["v-60", "h-200"] ],
    [ "dht1:SDA", "esp:15",    "green", ["v-20", "h-200"] ],
    [ "dht1:GND", "esp:GND.1", "black", ["v60",  "h-210"] ]
  ],
  "dependencies": {}
}