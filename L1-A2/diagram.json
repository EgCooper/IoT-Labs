{
  "version": 1,
  "author": "Lab IoT - Arduino Nano + NTC + LCD I2C",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-arduino-nano", "id": "nano", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ntc-temperature-sensor", "id": "ntc1", "top": -80, "left": 280, "attrs": { "temperature": "25" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": 200, "attrs": { "value": "10000" }, "rotate": 90 },
    { "type": "wokwi-lcd1602", "id": "lcd1", "top": 160, "left": 160, "attrs": { "pins": "i2c", "i2cAddress": "0x27" } }
  ],
  "connections": [
    [ "nano:TX", "$serialMonitor:RX", "", [] ],
    [ "nano:RX", "$serialMonitor:TX", "", [] ],
    [ "ntc1:VCC", "nano:5V",   "red",   ["v-30", "h-200"] ],
    [ "ntc1:OUT", "r1:2",      "orange",["v0"] ],
    [ "r1:1",     "nano:5V",   "red",   ["v-10", "h-130"] ],
    [ "r1:2",     "nano:A0",   "orange",["h-80", "v60"] ],
    [ "ntc1:GND", "nano:GND.1","black", ["v60",  "h-230"] ],
    [ "lcd1:GND", "nano:GND.2","black", ["v20",  "h-100"] ],
    [ "lcd1:VCC", "nano:5V",   "red",   ["v-10", "h-80"]  ],
    [ "lcd1:SDA", "nano:A4",   "blue",  ["v0"] ],
    [ "lcd1:SCL", "nano:A5",   "yellow",["v10", "h20"] ]
  ],
  "dependencies": {}
}